# TerraTwin Environment Configuration Template
PROJECT_NAME=TerraTwin
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostGIS container on 5433 to avoid host collision)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=terratwin

# Storage directories
DATA_DIR=../data

