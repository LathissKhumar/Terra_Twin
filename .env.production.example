# Copy to .env.production and replace every CHANGE_ME value.
TERRATWIN_DOMAIN=terratwin.example.com
TERRATWIN_PUBLIC_ORIGIN=https://terratwin.example.com
TERRATWIN_AUTH_USER=terratwin-admin
TERRATWIN_AUTH_HASH=CHANGE_ME_CADDY_BCRYPT_HASH
POSTGRES_USER=terratwin
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=terratwin
# Keep application data on a persistent disk with restrictive ownership.
TERRATWIN_DATA_DIR=./data
