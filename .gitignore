# TerraTwin .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/

# Data rasters & outputs (keep directory structure with .gitkeep)
data/raw/earth/*
!data/raw/earth/.gitkeep
data/raw/mars/*
!data/raw/mars/.gitkeep
data/raw/moon/*
!data/raw/moon/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/derived/*
!data/derived/.gitkeep
data/results/*
!data/results/.gitkeep
data/manifests/*.json

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env.local

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

